# Banco Postgres e Redis
DATABASE_URL="postgresql://dnapoles:dnapoles@localhost:5432/dnapoles"
REDIS_URL="redis://localhost:6379"

# Segredo para sessões e para cifrar credenciais de pagamento (mínimo 16 caracteres; NÃO reutilize)
APP_SECRET="gere-um-segredo-longo-aqui"
APP_URL="http://localhost:3000"

# true = lojas sempre abertas (só para testes). Em produção: false
DEMO_ALWAYS_OPEN="false"
# true = PIX simulado com botão "Simular pagamento". Em produção: false
ENABLE_FAKE_PAYMENTS="true"
PIX_EXPIRES_MINUTES="15"

# Geocodificação do endereço (para áreas por raio/polígono): none | nominatim
GEOCODER="none"

# Senha dos usuários criados no primeiro seed
SEED_PASSWORD="dnapoles123"
